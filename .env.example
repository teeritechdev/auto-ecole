# Copiez ce fichier vers ".env" puis renseignez de vraies valeurs avant de lancer :
#   docker compose --env-file .env -f docker-compose.prod.yml up -d --build
# Ne committez JAMAIS le fichier ".env" réel (il est exclu par .gitignore).

# --- Base de données PostgreSQL ---
DB_NAME=auto_ecole_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Sécurité ---
# Générez une clé forte : openssl rand -base64 64
JWT_SECRET=change-me
JWT_EXPIRATION_MS=7200000

# --- Comportement de l'application en production ---
# false : désactive les comptes de démo (admin/admin123, etc.) ; un compte
# admin unique est créé avec un mot de passe aléatoire affiché une seule
# fois dans les logs du conteneur backend au premier démarrage.
APP_SEED_ENABLED=false
# false : Swagger UI / /v3/api-docs devient réservé aux utilisateurs ADMIN authentifiés.
APP_SWAGGER_PUBLIC=false
APP_ETABLISSEMENT_NOM=NERWAYA AUTO-ÉCOLE

# Origines autorisées à appeler l'API (liste séparée par des virgules).
# Si le frontend est servi par le même nginx que celui de ce dépôt (accès via
# le même domaine/port), le navigateur n'a pas besoin de CORS : laissez la
# valeur par défaut. Ajoutez ici uniquement les domaines qui appelleraient
# l'API depuis un autre domaine/port.
CORS_ALLOWED_ORIGINS=http://localhost

# --- Réseau ---
# Port HTTP exposé sur la machine hôte pour le frontend (nginx)
HTTP_PORT=80
